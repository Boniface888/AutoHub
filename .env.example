NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://autohub:change-this-password@localhost:5432/autohub
JWT_SECRET=replace-with-at-least-32-random-characters
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Password reset emails are sent with Resend. Use a verified sending domain in production.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=AutoHub <accounts@your-verified-domain.com>
APP_URL=http://localhost:5173
